         : swapchain(swapchain), swapchainImages(swapchainImages),
           extent(extent) {
     // get updated configuration
@@ -62,11 +63,28 @@ LsContext::LsContext(const Hooks::DeviceInfo& info, VkSwapchainKHR swapchain,
 
         if (conf.multiplier <= 1) return;
     }
-    // we could take the format from the swapchain,
-    // but honestly this is safer.
-    const VkFormat format = conf.hdr
-        ? VK_FORMAT_R8G8B8A8_UNORM
-        : VK_FORMAT_R16G16B16A16_SFLOAT;
+    // Honor the actual swapchain format. vkCmdBlitImage does not swizzle
+    // channels, so an RGBA intermediate blitted into a BGRA swapchain image
+    // produces a red/blue swap. Falling back to the inverted-ternary defaults
+    // when the swapchain format is not directly usable as a transfer target.
+    VkFormat format = swapchainFormat;
+    switch (swapchainFormat) {
+        case VK_FORMAT_R8G8B8A8_UNORM:
+        case VK_FORMAT_R8G8B8A8_SRGB:
+        case VK_FORMAT_B8G8R8A8_UNORM:
+        case VK_FORMAT_B8G8R8A8_SRGB:
+        case VK_FORMAT_A8B8G8R8_UNORM_PACK32:
+        case VK_FORMAT_A8B8G8R8_SRGB_PACK32:
+        case VK_FORMAT_A2R10G10B10_UNORM_PACK32:
+        case VK_FORMAT_A2B10G10R10_UNORM_PACK32:
+        case VK_FORMAT_R16G16B16A16_SFLOAT:
+            break;
+        default:
+            format = conf.hdr
+                ? VK_FORMAT_R16G16B16A16_SFLOAT
+                : VK_FORMAT_R8G8B8A8_UNORM;
+            break;
+    }
 
     // prepare textures for lsfg
     std::array<int, 2> fds{};
